import tkinter as tk
import time
import math

root = tk.Tk()
root.title("Пісочний годинник")

canvas = tk.Canvas(root, width=500, height=400, bg="white")
canvas.pack()

panel = tk.Frame(root)
panel.pack(pady=5)

time_entry = tk.Entry(panel, width=10)
time_entry.pack(side="left", padx=5)
time_entry.insert(0, "10")

start_button = tk.Button(panel, text="Старт")
start_button.pack(side="left")

message_label = tk.Label(root, text="Введіть час у секундах")
message_label.pack()

running = False
flipping = False

start_time = 0
total_time = 10
progress = 0

def start_timer():
    global running, start_time, progress, angle, total_time

    if running or flipping:
        return

    try:
        total_time = float(time_entry.get())

        if total_time <= 0:
            message_label.config(text="Введіть число більше 0")
            return

    except ValueError:
        message_label.config(text="Введіть час числом")
        return

    angle = 0
    progress = 0
    start_time = time.time()
    running = True

    message_label.config(text="Пісок сиплеться...")
    animate()


def animate():
    global progress, running

    progress = (time.time() - start_time) / total_time

    if progress >= 1:
        progress = 1
        running = False
        message_label.config(text="Час вийшов! Можна ввести новий час")

    draw_scene()

    if running:
        root.after(16, animate)
    else:
        draw_scene()


def start_click():
    global flipping

    if running or flipping:
        return

    if progress >= 1:
        flipping = True
        message_label.config(text="Годинник перевертається...")
        flip()
    else:
        start_timer()


start_button.config(command=start_click)


CX = 250
CY = 200

angle = 0

def sx(x):
    return CX + x


def sy(y):
    return CY - y


def rotate(x, y):
    r = math.radians(angle)
    new_x = x * math.cos(r) - y * math.sin(r)
    new_y = x * math.sin(r) + y * math.cos(r)
    return sx(new_x), sy(new_y)


def draw_line(points, color, width):
    coords = []

    for x, y in points:
        px, py = rotate(x, y)
        coords.append(px)
        coords.append(py)

    canvas.create_line(coords, fill=color, width=width)


def draw_polygon(points, color):
    coords = []

    for x, y in points:
        px, py = rotate(x, y)
        coords.append(px)
        coords.append(py)

    canvas.create_polygon(coords, fill=color, outline=color)


def draw_hourglass():
    draw_line([(-100, 100), (100, 100), (0, 0), (-100, 100)], "saddlebrown", 5)
    draw_line([(-100, -100), (100, -100), (0, 0), (-100, -100)], "saddlebrown", 5)

    draw_line([(-120, 100), (120, 100)], "saddlebrown", 5)
    draw_line([(-120, -100), (120, -100)], "saddlebrown", 5)


def draw_sand():
    if progress < 1:
        h = 100 * (1 - progress)
        draw_polygon([(-h, h), (h, h), (0, 0)], "gold")

    if progress > 0:
        pile_height = 80 * progress
        pile_width = 100 * progress
        draw_polygon(
            [(-pile_width, -100),
             (pile_width, -100),
             (0, -100 + pile_height)],
            "gold"
        )

    if 0 < progress < 1 and not flipping:
        draw_line([(0, 0), (0, -85)], "gold", 2)


def draw_scene():
    canvas.delete("all")
    draw_hourglass()
    draw_sand()


def flip():
    global angle, flipping

    angle += 4

    if angle >= 180:
        angle = 0
        flipping = False
        start_timer()
    else:
        draw_scene()
        root.after(16, flip)


draw_scene()

root.mainloop()
